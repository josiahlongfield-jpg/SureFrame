generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Direct (non-pooled) connection for migrations. Same as DATABASE_URL locally.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ---------- Auth.js ----------

model User {
  id                  String             @id @default(cuid())
  name                String?
  email               String             @unique
  emailVerified       DateTime?
  image               String?
  createdAt           DateTime           @default(now())
  accounts            Account[]
  sessions            Session[]
  memberships         Membership[]
  videos              Video[]
  replies             Reply[]
  /// The workspace this user is working in when they belong to several (e.g. their own and an employer's).
  activeWorkspaceId   String?
  assignedClients     Client[]           @relation("ClientAssignee")
  invitesSent         Invite[]           @relation("InviteSender")
  supportTickets      SupportTicket[]
  teamNotifications   TeamNotification[]
  noticesSent         StaffNotice[]      @relation("NoticeFrom")
  noticesReceived     StaffNotice[]      @relation("NoticeTo")
  /// They asked to delete their account (lib/accountDeletion.ts). Only a sign-in after this can keep it.
  deletionRequestedAt DateTime?
  /// Closed until then and deleted for good after it, unless they sign in and keep it. Null while active.
  deleteAt            DateTime?
  /// When they were emailed that the deletion is a few days away.
  deletionWarnedAt    DateTime?
  /// This login suspended by SureFrame support (lib/support/admin.ts): it can't use any workspace until lifted.
  suspendedAt         DateTime?
  /// Why, for support only. Never shown to the user or sent to the help chat.
  suspendedReason     String?
  /// Sign-ins made before this no longer work ("Sign out everywhere"). Null: no sign-in has been revoked.
  sessionsValidAfter  DateTime?
  /// Closed for good by SureFrame support: suspended and deleted on deleteAt, which the account holder can't undo.
  closedAt            DateTime?
  /// Finished the one-step welcome after signing up (name and business name). Owners are asked until then.
  onboardedAt         DateTime?

  @@index([deleteAt])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Workspaces & billing ----------

enum Plan {
  FREE
  SOLO
  STUDIO
  AGENCY
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id                    String             @id @default(cuid())
  name                  String
  plan                  Plan               @default(FREE)
  stripeCustomerId      String?            @unique
  stripeSubscriptionId  String?            @unique
  subscriptionStatus    String?
  /// A paid plan given free by the founder (trials, partners). Used whenever there's no active subscription.
  complimentaryPlan     Plan?
  currentPeriodEnd      DateTime?
  /// When a cancelled subscription ends (it stays paid until then). Null while it renews.
  cancelsAt             DateTime?
  /// "month" or "year": how often the subscription bills, so add-ons are priced to match. Null without one.
  billingInterval       String?
  /// Client seats bought on top of the plan's included seats.
  extraClientSeats      Int                @default(0)
  /// Staff seats bought on top of the plan's included staff (Studio and Agency).
  extraStaffSeats       Int                @default(0)
  /// The subscription started during the founding offer, so it keeps founding prices (lib/founding.ts). From Stripe.
  foundingPrices        Boolean            @default(false)
  /// The subscription's discount in plain words ("SPRING20: 20% off your plan"), from Stripe (lib/offers.ts).
  discountLabel         String?
  /// When that discount stops applying. Null for one that lasts while subscribed or is for the next bill only.
  discountEndsAt        DateTime?
  /// Paid add-on: keep encrypted copies on the server instead of expiring them.
  cloudBackup           Boolean            @default(false)
  /// Paid add-on: AI transcripts and summaries. Transcripts are made on the
  /// team's devices; only the transcript text is sent to Claude for the summary.
  aiAssist              Boolean            @default(false)
  /// AI summaries given free by the founder (complimentary plans, no card).
  aiAssistComplimentary Boolean            @default(false)
  /// Fingerprint of the team's end-to-end key. The key itself never reaches the server.
  keyFingerprint        String?
  /// Someone left without an admin removing them (deleted their account), so
  /// the keys still need resetting. Holds their name for the prompt.
  keyResetNeeded        String?
  /// IANA time zone used for due dates and reminders, e.g. "Australia/Sydney".
  timezone              String?
  /// Reminder rules pre-selected on new to-dos (see lib/schedule.ts ReminderRule[]).
  reminderDefaults      Json?
  remindClientDefault   Boolean            @default(true)
  remindTeamDefault     Boolean            @default(false)
  /// Optional note the business adds to every reminder email.
  reminderMessage       String?
  /// Where client replies to reminder emails go.
  reminderReplyTo       String?
  /// Custom branding (paid plans) shown to clients: logo image and accent colour (#rrggbb).
  brandLogo             Bytes?
  brandLogoType         String?
  brandColor            String?
  /// Bumped on every branding change so logo URLs bust caches.
  brandVersion          Int                @default(0)
  /// Original recordings that finished uploading, on any plan. Deleting or expiring a video doesn't lower
  /// it. The Free plan's lifetime limit is checked against it (lib/videoAllowance.ts).
  videosRecorded        Int                @default(0)
  /// The owner closed their account: deleted with it on this date unless they keep it. Clients' links,
  /// reminders and emails stop meanwhile (lib/accountDeletion.ts).
  deleteAt              DateTime?
  /// We stopped the subscription because of that (renewal off, or cancelled if a payment was outstanding).
  /// Keeping the account turns renewal back on while the plan is still running.
  renewalStoppedAt      DateTime?
  /// This business's referral codes, one per paid plan it has been on (lib/referrals.ts).
  referralCodes         ReferralCode[]
  /// Suspended by SureFrame support (lib/support/admin.ts): members can't use it, clients' links show it as
  /// unavailable and nothing is emailed in its name. Nothing is deleted because of it.
  suspendedAt           DateTime?
  /// Why, for support only. Never shown to the business or sent to the help chat.
  suspendedReason       String?
  /// Optional note from support shown to its members on the suspended page.
  suspendedNote         String?
  /// Closed for good by SureFrame support: stays suspended and is deleted on deleteAt; the owner can't keep it.
  closedAt              DateTime?
  /// Legal hold: no automatic clean-up deletes anything of this workspace while set (lib/support/admin.ts).
  legalHoldAt           DateTime?
  /// Why, for support only.
  legalHoldReason       String?
  /// The owner pressed "I've saved it" for the recovery key (first steps). Null: still reminded.
  recoveryKeySavedAt    DateTime?
  /// The owner dismissed the first-steps checklist before finishing it.
  firstStepsHiddenAt    DateTime?
  createdAt             DateTime           @default(now())
  members               Membership[]
  videos                Video[]
  clients               Client[]
  items                 Item[]
  invites               Invite[]
  keyRotations          KeyRotation[]
  aiUsages              AiUsage[]
  teamNotifications     TeamNotification[]
  staffNotices          StaffNotice[]
}

/// An invitation for a staff member to join a workspace. The link carries a
/// secret in its #fragment that unwraps the team key, so the server never sees it.
model Invite {
  id           String    @id @default(cuid())
  /// sha256 of the token in the invite link's path.
  tokenHash    String    @unique
  role         Role      @default(MEMBER)
  /// Who it is for, shown on the team page only.
  email        String?
  /// The team key, wrapped with the secret in the link fragment.
  teamKeyWrap  String
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  acceptedAt   DateTime?
  acceptedById String?
  revokedAt    DateTime?
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedById  String
  invitedBy    User      @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

/// Which team emails an owner or admin gets.
enum NotifyScope {
  ALL // everyone's clients
  SELECTED // only the staff members they picked
  MINE // only clients assigned to them (and replies they'd get anyway)
  OFF
}

model Membership {
  id                    String      @id @default(cuid())
  role                  Role        @default(MEMBER)
  /// What a MEMBER may do, set by the owner or an admin (lib/permissions.ts).
  /// Owners and admins always have full access; these only apply to members.
  /// See every client, not only the ones assigned to them (and unassigned "Shared" ones).
  seeAllClients         Boolean     @default(false)
  /// Add new clients (they're assigned to the member who adds them).
  addClients            Boolean     @default(true)
  /// Delete any video they can see, not only the ones they recorded.
  deleteAnyVideo        Boolean     @default(false)
  /// Send one recording to several clients at once (only clients they can see).
  sendToMany            Boolean     @default(true)
  /// Owners and admins: which client replies they're emailed about (lib/teamNotify.ts).
  /// Members: MINE = emailed when their clients reply (default), OFF = not.
  replyNotify           NotifyScope @default(MINE)
  /// With SELECTED: replies from the clients of these staff members (user ids).
  replyNotifyStaff      String[]    @default([])
  /// Owners and admins: which videos sent by staff they're emailed about.
  sentNotify            NotifyScope @default(OFF)
  /// With SELECTED: the staff members they asked to hear about ("Tell me when they send a video").
  sentNotifyStaff       String[]    @default([])
  /// A member's own reminder settings for their clients (Settings > Reminders).
  /// Null means "use the business's setting". Owners and admins use the business's.
  /// Reminder rules pre-selected on to-dos they create (lib/schedule.ts ReminderRule[]).
  myReminderDefaults    Json?
  myRemindClientDefault Boolean?
  myRemindTeamDefault   Boolean?
  /// Note added to reminder emails to the clients they look after.
  myReminderMessage     String?
  /// Where those clients' replies to reminder (and new video) emails go.
  myReminderReplyTo     String?
  /// Paused because the plan no longer covers this many staff (a subscription
  /// ended or lapsed). Lifted automatically when seats free up. Never the owner.
  pausedAt              DateTime?
  userId                String
  workspaceId           String
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace             Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ---------- Videos ----------

enum VideoStatus {
  RECORDING // chunks still arriving
  UPLOADED // raw file complete, playable as-is
  PROCESSING // transcoding to HLS
  READY // HLS available
  FAILED
  EXPIRED // server copy deleted after the relay window
}

model Video {
  id                   String        @id // short public id used in share links
  title                String        @default("Untitled recording")
  status               VideoStatus   @default(RECORDING)
  mimeType             String
  durationMs           Int?
  sizeBytes            BigInt        @default(0)
  storageKey           String
  uploadId             String? // S3 multipart upload id
  playbackUrl          String? // HLS url once transcoded
  thumbnailUrl         String?
  viewCount            Int           @default(0)
  /// Sent to a client while the upload was still finishing: email them once it's done.
  emailClientWhenReady Boolean       @default(false)
  password             String?
  expiresAt            DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  ownerId              String
  workspaceId          String
  /// The client this video was sent to. Videos are private: only workspace
  /// members and this client can watch them.
  clientId             String?
  client               Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// End-to-end encryption. The server stores only ciphertext and these
  /// wrapped (encrypted) copies of the video's key:
  encrypted            Boolean       @default(false)
  teamKeyWrap          String? /// video key, wrapped with the team key
  clientKeyWrap        String? /// video key, wrapped with the recipient client's key
  parentKeyWrap        String? /// reply media key, wrapped with the conversation's video key
  /// When the relay copy is deleted (null = kept, e.g. cloud backup).
  purgeAt              DateTime?
  /// When it was sent to its client (team overview counts sends by this, not by recording date).
  sentAt               DateTime?
  /// When the recorder was emailed that the relay copy is deleted within 24 hours.
  /// Cleared whenever purgeAt is rescheduled (cloud backup turned off again).
  expiryWarnedAt       DateTime?
  /// Set on a copy made to send the same recording to another client. The
  /// copy shares the original's stored file and key but has its own private
  /// conversation, so clients never see each other's replies.
  sourceId             String?
  source               Video?        @relation("VideoCopies", fields: [sourceId], references: [id], onDelete: Cascade)
  copies               Video[]       @relation("VideoCopies")
  /// Set when this video is the media of a reply in another video's conversation.
  replyToId            String?
  /// sha256 of a one-time token that lets a guest (no account) upload this reply's media.
  uploadTokenHash      String?
  /// A short message from the business to this conversation's client, shown above the video.
  /// Ciphertext, sealed with the video's key on the team's device (like replies).
  message              String?
  owner                User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  workspace            Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parts                UploadPart[]
  replies              Reply[]       @relation("Conversation")
  asReply              Reply?        @relation("ReplyMedia")
  reactions            Reaction[]
  insight              VideoInsight?
  thumb                VideoThumb?

  @@index([workspaceId, createdAt])
  @@index([replyToId])
  @@index([sourceId])
  @@index([purgeAt])
  @@index([clientId])
  @@index([ownerId])
}

/// AI transcript and summary of a recording (the AI summaries add-on). Both
/// are end-to-end encrypted on the team's device with the video's key, like
/// replies, so the server only ever stores ciphertext. Copies sent to other
/// clients share the original recording's insight.
model VideoInsight {
  videoId    String   @id
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  /// Ciphertext of the transcript (JSON: language and timed segments).
  transcript String
  /// Ciphertext of the summary (JSON: overview, key points, action items). Null if summarising failed.
  summary    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// AI summaries made per workspace per calendar month (UTC), for the fair-use cap.
model AiUsage {
  workspaceId String
  /// "YYYY-MM"
  month       String
  summaries   Int       @default(0)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, month])
}

model UploadPart {
  videoId    String
  partNumber Int
  etag       String?
  sizeBytes  Int
  video      Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([videoId, partNumber])
}

enum ReplyKind {
  TEXT
  VIDEO
  AUDIO
}

/// One message in a video's conversation. Viewers can reply without an account.
model Reply {
  id           String    @id @default(cuid())
  kind         ReplyKind
  /// Ciphertext when encrypted (sealed with the conversation's video key).
  body         String?
  encrypted    Boolean   @default(false)
  timestampMs  Int?
  authorName   String
  createdAt    DateTime  @default(now())
  videoId      String
  mediaId      String?   @unique
  authorUserId String?
  /// A video or voice reply waiting for its author to review it: hidden from everyone else
  /// until they press Send (cleared then), or deleted if they discard it.
  heldAt       DateTime?
  /// Written by the client (not the team). Kept apart from authorUserId, which empties if a team member's login is deleted.
  byClient     Boolean   @default(false)
  video        Video     @relation("Conversation", fields: [videoId], references: [id], onDelete: Cascade)
  media        Video?    @relation("ReplyMedia", fields: [mediaId], references: [id], onDelete: Cascade)
  authorUser   User?     @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([videoId, createdAt])
  @@index([authorUserId])
}

model Reaction {
  id           String   @id @default(cuid())
  emoji        String
  timestampMs  Int?
  createdAt    DateTime @default(now())
  videoId      String
  /// Who reacted, so a second tap takes it back: the team member (a plain id, no relation), or the
  /// conversation's client (byClient). Older reactions have neither and stay as they were.
  authorUserId String?
  byClient     Boolean  @default(false)
  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId])
}

/// Someone a creator works with (e.g. a personal trainer's client). Clients
/// never pay: each uses one of the workspace's client seats and gets a
/// private link to watch and reply to the videos sent to them.
model Client {
  id                 String        @id @default(cuid())
  name               String
  email              String?
  /// Secret in the client's personal link. Treat like a password.
  token              String        @unique
  /// The client's end-to-end key, wrapped with the team key. The unwrapped key
  /// travels only in the link fragment (#k=…), which browsers never send to servers.
  teamKeyWrap        String?
  /// Fingerprint of the client's current key, set once it has been replaced.
  /// Lets the client's device notice an old key and pick up the new one.
  keyFingerprint     String?
  /// The client turned reminder emails off (from an email's unsubscribe link or their inbox).
  remindersOff       Boolean       @default(false)
  /// First time the client opened their personal link (the one with their key).
  /// Until then a business is reminded to send it themselves.
  linkOpenedAt       DateTime?
  /// First time the business copied the client's personal link (to send it).
  /// From then on new videos are sent with a plain Send, not the link reminder.
  linkSentAt         DateTime?
  /// Paused because the business's plan no longer covers this many clients
  /// (a subscription ended or lapsed). Lifted automatically when seats free up.
  pausedAt           DateTime?
  /// The staff member who looks after this client (Studio and Agency teams).
  assignedToId       String?
  assignedTo         User?         @relation("ClientAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  /// Removed by the business: the link stops working and the seat is freed at once.
  removedAt          DateTime?
  /// When a removed client is deleted for good (removedAt + 30 days); until then they can be restored.
  /// Null while active. A removed client without a date is never deleted (lib/clientRemoval.ts dates them).
  purgeAt            DateTime?
  /// When the business was warned that this removed client is about to be deleted.
  purgeWarnedAt      DateTime?
  /// Who removed them. A plain id, no relation, so it survives them leaving the team.
  removedById        String?
  /// Link turned off by SureFrame support: the client can't open anything and can't be sent anything. Kept
  /// through key resets (the flag is on the row, not the token). The seat stays in use.
  linkDisabledAt     DateTime?
  /// Why, for support only.
  linkDisabledReason String?
  workspaceId        String
  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  videos             Video[]
  items              Item[]
  keyRotations       KeyRotation[]

  @@index([workspaceId, removedAt])
  @@index([assignedToId])
  @@index([purgeAt])
}

enum ItemKind {
  TASK
  NOTE
}

/// A to-do or note, either general or about one client. The text is end-to-end
/// encrypted: with the team key when private, or with the client's key when
/// shared with that client (the team can unwrap the client key).
model Item {
  id           String     @id @default(cuid())
  kind         ItemKind
  body         String /// ciphertext
  done         Boolean    @default(false)
  dueAt        DateTime?
  shared       Boolean    @default(false)
  /// Repeat rule (lib/schedule.ts Repeat); the next occurrence is created when this one is done or overdue.
  repeat       Json?
  /// Occurrences of one repeating to-do share a seriesId.
  seriesId     String?
  spawnedNext  Boolean    @default(false)
  /// Reminder rules (lib/schedule.ts ReminderRule[]) and who gets them.
  reminders    Json?
  remindClient Boolean    @default(false)
  remindTeam   Boolean    @default(false)
  authorName   String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  workspaceId  String
  clientId     String?
  workspace    Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client       Client?    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scheduled    Reminder[]

  @@index([workspaceId, clientId])
  @@index([spawnedNext, dueAt])
  @@index([seriesId])
}

enum ReminderTo {
  CLIENT
  TEAM
}

/// One reminder email waiting to go out.
model Reminder {
  id     String     @id @default(cuid())
  sendAt DateTime
  sentAt DateTime?
  to     ReminderTo
  error  String?
  itemId String
  item   Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([sentAt, sendAt])
  @@index([itemId])
}

/// Video bytes kept in Postgres by the "db" storage driver (previews and
/// small deployments without S3/R2). Each upload part is one row; the file
/// is the parts in order, so nothing is copied when an upload completes.
model StoredPart {
  key        String
  partNumber Int
  size       Int
  data       Bytes

  @@id([key, partNumber])
}

/// Fixed-window request counters for rate limiting (lib/rateLimit.ts).
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

/// One-time code handing a web sign-in to the mobile app (PKCE, see /mobile/handoff).
model MobileCode {
  codeHash  String    @id
  challenge String
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
}

/// A key replaced after someone left the team: the new key, wrapped with the
/// old one. Devices still holding the old key follow these to the current
/// key. Served only to current members (team key) or the client themselves.
model KeyRotation {
  id              String    @id @default(cuid())
  /// Fingerprint of the key that unwraps `wrap`.
  fromFingerprint String
  /// The next key, wrapped with the key named by fromFingerprint.
  wrap            String
  createdAt       DateTime  @default(now())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Set for a client's key; null for the team key.
  clientId        String?
  client          Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workspaceId, clientId])
  @@index([clientId])
}

enum TicketStatus {
  OPEN // the assistant is handling it
  NEEDS_HUMAN // handed to the founder; waiting on a person
  ANSWERED // a person replied
  CLOSED
}

enum SupportAuthor {
  CUSTOMER
  ASSISTANT
  STAFF
}

/// A support conversation. Starts with the AI assistant; escalated ones reach a person.
model SupportTicket {
  id          String           @id @default(cuid())
  /// Unguessable id the browser keeps so a signed-out visitor can come back to their chat.
  accessToken String           @unique
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String?
  email       String?
  status      TicketStatus     @default(OPEN)
  /// The assistant's one-paragraph summary when it hands over.
  summary     String?
  urgent      Boolean          @default(false)
  messages    SupportMessage[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, updatedAt])
  @@index([userId])
}

model SupportMessage {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    SupportAuthor
  body      String
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

enum TeamNotificationKind {
  CLIENT_REPLY
  VIDEO_SENT
}

/// A team email waiting to go out. Several within 15 minutes for the same
/// person and conversation (replies) or sender (videos sent) are combined
/// into one short digest (lib/teamNotify.ts).
model TeamNotification {
  id          String               @id @default(cuid())
  kind        TeamNotificationKind
  /// Who gets the email.
  userId      String
  workspaceId String
  /// What one email covers: the conversation (replies) or the sender (videos sent).
  groupKey    String
  /// The staff member who sent the video (VIDEO_SENT).
  actorUserId String?
  clientId    String?
  videoId     String?
  createdAt   DateTime             @default(now())
  sentAt      DateTime?
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([sentAt, createdAt])
  @@index([userId, groupKey])
  @@index([workspaceId])
}

/// The last team email per person and group, so bursts send one email per 15 minutes.
model NotifyThrottle {
  key        String   @id
  lastSentAt DateTime
}

/// A reminder an owner or admin sends to a staff member: emailed, and shown
/// in the app until they dismiss it. Kept as history.
model StaffNotice {
  id          String    @id @default(cuid())
  workspaceId String
  fromUserId  String
  toUserId    String
  message     String
  /// Optional app path it links to (/clients/{id} or /v/{id}).
  link        String?
  linkLabel   String?
  createdAt   DateTime  @default(now())
  emailedAt   DateTime?
  dismissedAt DateTime?
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  from        User      @relation("NoticeFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to          User      @relation("NoticeTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([toUserId, workspaceId, dismissedAt])
  @@index([workspaceId, createdAt])
}

/// What SureFrame support did to an account and why (lib/support/admin.ts). Written in the same transaction as
/// the change. No foreign keys, so the record outlives the account it's about; kept 7 years, then pruned.
/// Never sent to the help chat.
model AdminAction {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorUserId String?
  /// The support admin, as they were at the time.
  actorEmail  String
  /// What was done, e.g. "workspace.suspend", "client.link_off", "account.close".
  action      String
  workspaceId String?
  userId      String?
  clientId    String?
  /// Who or what it was done to, as named at the time (email, workspace name, client name).
  target      String?
  reason      String?
  /// Before and after values, billing changes, whether the owner was emailed.
  details     Json?

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

/// Email addresses that can't sign in or sign up again (an account closed by support). Only a SHA-256 hash of
/// the inbox (lower-cased, without +tags, and without dots for Gmail) is kept, never the address itself.
model BlockedEmail {
  emailHash  String   @id
  createdAt  DateTime @default(now())
  reason     String
  /// The support admin who blocked it.
  actorEmail String
  /// The account it came from, if any. A plain id: the block outlives the account.
  userId     String?
}

/// Each time someone agreed to the Terms of Service and Privacy Policy (lib/terms.ts): evidence of the agreement.
/// Append-only: the app only inserts rows; the daily job deletes rows older than 7 years, except a login's latest while
/// the login exists. No foreign keys, so it
/// outlives the account.
model TermsAcceptance {
  id             String   @id @default(cuid())
  userId         String
  /// The account's email address at the time.
  email          String
  termsVersion   String
  privacyVersion String
  /// The deployed commit (VERCEL_GIT_COMMIT_SHA), so the exact text shown can be found in the code history.
  appVersion     String?
  acceptedAt     DateTime @default(now())
  ip             String?
  userAgent      String?
  /// "signup" (first agreement) or "update" (agreeing to a newer version, or for the first time with an older account).
  method         String

  @@index([userId, acceptedAt])
  @@index([acceptedAt])
}

/// The email telling an existing account holder about new versions of the Terms of Service and Privacy Policy
/// (lib/terms.ts sendTermsNotices). The new versions take effect for them TERMS_NOTICE_DAYS after sentAt; until then they
/// carry on without agreeing. Evidence of the notice: no foreign keys, so it outlives the account, and deleted after 7 years.
model TermsNotice {
  id             String   @id @default(cuid())
  userId         String
  /// The address it was sent to.
  email          String
  termsVersion   String
  privacyVersion String
  sentAt         DateTime @default(now())

  @@unique([userId, termsVersion, privacyVersion])
  @@index([sentAt])
}

/// A still from the recording for the library, made on a team member's
/// device and end-to-end encrypted with the video's key: the server can't
/// see it. Copies sent to other clients use the original's. Deleted with the
/// recording's server copy.
model VideoThumb {
  videoId   String   @id
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  /// The sealed JPEG, base64url.
  data      String
  createdAt DateTime @default(now())
}

/// A paying business's code for referring another business (lib/referrals.ts). One per business, and it works once:
/// the business that subscribes with it gets 10% off its plan on every bill, and this one the same from its next
/// bill on, for as long as the business it brought stays subscribed.
model ReferralCode {
  code              String    @id
  workspaceId       String    @unique
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now())
  /// When a business subscribed with it (its first payment went through).
  usedAt            DateTime?
  usedByWorkspaceId String?   @unique
  /// When the sharer's 10% goes on their subscription: just before their next bill.
  rewardDueAt       DateTime?
  rewardAppliedAt   DateTime?
  /// Never given: the sharer's subscription ended or was set to end, or the referred business left, first.
  rewardLapsedAt    DateTime?
  /// Taken off again because the referred business's subscription ended.
  rewardEndedAt     DateTime?

  @@index([rewardDueAt])
}
