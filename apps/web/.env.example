# Postgres
DATABASE_URL="postgresql://framecast:framecast@localhost:5432/framecast"
# Direct connection for migrations (Neon on Vercel sets this for you)
DATABASE_URL_UNPOOLED="postgresql://framecast:framecast@localhost:5432/framecast"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true
# Google sign-in (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Email-only sign in for local dev, and for hosted previews behind PREVIEW_PASSWORD. Ignored on the live
# site, and turned off automatically once email links are on (RESEND_API_KEY or AUTH_EMAIL_LINKS).
AUTH_DEV_LOGIN=true
# Local testing of email-link sign-in without Resend (emails go to .data/outbox).
AUTH_EMAIL_LINKS=false

APP_URL="http://localhost:3000"

# Storage: leave S3_BUCKET empty to store files on local disk (.data/uploads).
# For Cloudflare R2 set S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# With a bucket, browsers upload straight to it (needs the bucket CORS rule in
# README); DIRECT_UPLOADS=off sends parts through the API instead (self-hosting only:
# its 5 MB parts are over Vercel's 4.5 MB request limit). Both are read when the
# app is built, so redeploy after changing S3_BUCKET or DIRECT_UPLOADS.
S3_BUCKET=""
# Without a bucket: "db" keeps files in Postgres, "local" on disk (default: db on Vercel, local elsewhere).
# STORAGE_DRIVER=
# Folder for the local disk driver (default .data/uploads).
# LOCAL_STORAGE_DIR=
S3_REGION="auto"
S3_ENDPOINT=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint https://<your-domain>/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=""
# Products and prices are created in Stripe automatically (see src/lib/billing.ts).
# Checkout uses Managed Payments (Stripe as merchant of record); set "off" to use plain Checkout.
STRIPE_MANAGED_PAYMENTS=""
# Founding prices (lib/founding.ts): the offer's last day, YYYY-MM-DD in Queensland time, normally set in code.
# Set here only to override it, e.g. for tests; "off" turns it off.
FOUNDING_ENDS=""

# Scheme the mobile app registers (must match apps/mobile/app.json "scheme")
MOBILE_APP_SCHEME="sureframe"
# App sign-in is off on the live site until this is "on" (when the apps launch)
MOBILE_SIGNIN=""

# Encrypted relay: days the server keeps a copy when cloud backup is off
RELAY_RETENTION_DAYS=30
# Secret for the daily purge job: GET /api/cron/purge with Authorization: Bearer $CRON_SECRET
CRON_SECRET=""
# Reminder emails via Resend (https://resend.com). Without a key, emails are written to .data/outbox.
RESEND_API_KEY=""
# Sender for sign-in links and reminders; the domain must be verified in Resend.
MAIL_FROM="hello@sureframe.app"
# Reminder job: GET /api/cron/reminders every 5 minutes with Authorization: Bearer $CRON_SECRET

# Help chat assistant and AI summaries (Anthropic). Without a key, both are switched off.
ANTHROPIC_API_KEY=""
# Inbox told when the help chat hands a conversation to a person.
SUPPORT_EMAIL=""
# Comma-separated emails who can answer tickets at /support (defaults to SUPPORT_EMAIL).
# SUPPORT_AGENTS=
# Daily ceilings on the help chat across everyone: AI answers (default 2000), hand-over
# emails to support (default 200), and of those, ones from signed-out visitors (default 50).
# SUPPORT_AI_DAILY_CAP=
# The same ceiling for the help chat on client pages (default 1000 AI answers a day).
# CLIENT_HELP_AI_DAILY_CAP=
# SUPPORT_MAIL_DAILY_CAP=
# SUPPORT_MAIL_VISITOR_CAP=
# Comma-separated emails with the founder's support powers (suspend, close, delete, legal hold).
# Defaults to SUPPORT_EMAIL only, not every SUPPORT_AGENTS member.
# SUPPORT_ADMINS=
# Set to "on" to email existing account holders about new Terms/Privacy versions (daily job;
# the new versions apply to each of them 30 days after their email).
# TERMS_NOTICES=
# Tests only: stand-in for huggingface.co when downloading the speech model (ignored in production).
# HF_BASE_URL=
# Set to "off" to switch off rate limiting (for automated tests only).
# RATE_LIMITS=
# Upload part size in bytes for recordings (default 5 MB, or 2 MB on Vercel without a bucket).
# NEXT_PUBLIC_UPLOAD_PART_BYTES=
# Maintenance mode: "on" shows the maintenance page to everyone except a browser that opened
# /?owner=<MAINTENANCE_KEY> (the key needs at least 16 characters, or that bypass is off).
# MAINTENANCE=
# MAINTENANCE_KEY=
# The browser extension: its store page (shows the before-recording prompt when set), an optional
# Edge Add-ons page, and the store extension IDs allowed to use the camera on our pages (comma-separated).
# NEXT_PUBLIC_EXTENSION_URL=
# NEXT_PUBLIC_EXTENSION_URL_EDGE=
# EXTENSION_IDS=
# Join recording pieces into parts of this many bytes (tests only; defaults to the smallest part size).
# UPLOAD_JOIN_BYTES=
