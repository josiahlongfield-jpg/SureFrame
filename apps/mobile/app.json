{
  "expo": {
    "name": "SureFrame",
    "slug": "sureframe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sureframe.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F2747",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sureframe.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-video",
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "SureFrame uses your camera to record video messages.",
          "microphonePermission": "SureFrame uses your microphone to record your voice.",
          "recordAudioAndroid": true
        }
      ]
    ],
    "scheme": "sureframe",
    "extra": {
      "apiUrl": "http://localhost:3000"
    }
  }
}
